{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Contact Manager: Open app",
      "type": "process",
      "command": "python3",
      "args": [
        "scripts/run.py",
        "--background"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Contact Manager: Build only",
      "type": "process",
      "command": "python3",
      "args": [
        "scripts/run.py",
        "--build-only"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
